<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Wardrobe - Armario & Outfits</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkbg: '#0b0b0e',
                        darkcard: '#141419',
                        darkborder: '#262630',
                        ikerAccent: '#3b82f6',
                        ikerGlow: '#1d4ed8',
                        saraAccent: '#ec4899',
                        saraGlow: '#be185d'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts Inter & FontAwesome Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0b0b0e;
            color: #f3f4f6;
        }
        /* Glassmorphism custom effects */
        .glass-panel {
            background: rgba(20, 20, 25, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glass-card {
            background: rgba(26, 26, 34, 0.6);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .glass-card:hover {
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0b0b0e;
        }
        ::-webkit-scrollbar-thumb {
            background: #262630;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #3b3b4f;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-blue-500 selection:text-white">

    <!-- TOP HEADER / NAVBAR -->
    <header class="sticky top-0 z-40 glass-panel border-b border-darkborder shadow-2xl">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                
                <!-- Logo & Brand -->
                <div class="flex items-center space-x-3">
                    <div id="brand-icon" class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center text-white shadow-lg shadow-blue-500/20 transition-all duration-300">
                        <i class="fa-solid fa-shirt text-xl"></i>
                    </div>
                    <div>
                        <h1 class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
                            SMART WARDROBE <span class="text-xs px-2 py-0.5 rounded-full bg-white/10 text-gray-300 font-normal">v2.5</span>
                        </h1>
                        <p class="text-xs text-gray-400">Armario Inteligente & Stylist</p>
                    </div>
                </div>

                <!-- USER SWITCHER (Iker / Sara) -->
                <div class="flex items-center bg-black/40 p-1.5 rounded-2xl border border-white/10">
                    <button id="user-btn-iker" onclick="switchUser('iker')" 
                        class="flex items-center space-x-2 px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-300 bg-blue-600 text-white shadow-lg shadow-blue-600/30">
                        <i class="fa-solid fa-mars text-blue-200"></i>
                        <span>Iker</span>
                    </button>
                    <button id="user-btn-sara" onclick="switchUser('sara')" 
                        class="flex items-center space-x-2 px-4 py-2 rounded-xl text-sm font-semibold text-gray-400 hover:text-white transition-all duration-300">
                        <i class="fa-solid fa-venus text-pink-400"></i>
                        <span>Sara</span>
                    </button>
                </div>

            </div>
        </div>

        <!-- MAIN SECTION NAVIGATION TABS -->
        <div class="border-t border-white/5 bg-black/20">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-center sm:justify-start space-x-2 sm:space-x-6 py-2">
                <button onclick="switchTab('armario')" id="tab-btn-armario" 
                    class="nav-tab px-4 py-2 rounded-lg text-sm font-medium text-white bg-white/10 flex items-center gap-2 transition-all">
                    <i class="fa-solid fa-boxes-packing"></i>
                    <span>Mi Armario</span>
                </button>
                <button onclick="switchTab('outfits')" id="tab-btn-outfits" 
                    class="nav-tab px-4 py-2 rounded-lg text-sm font-medium text-gray-400 hover:text-white hover:bg-white/5 flex items-center gap-2 transition-all">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    <span>Generador Outfits</span>
                </button>
                <button onclick="switchTab('wishlist')" id="tab-btn-wishlist" 
                    class="nav-tab px-4 py-2 rounded-lg text-sm font-medium text-gray-400 hover:text-white hover:bg-white/5 flex items-center gap-2 transition-all">
                    <i class="fa-solid fa-heart"></i>
                    <span>Wishlist</span>
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full">

        <!-- ================= TAB 1: MI ARMARIO ================= -->
        <section id="tab-armario" class="space-y-6">
            
            <!-- Header section & Add button -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-darkcard p-6 rounded-2xl border border-darkborder shadow-xl">
                <div>
                    <h2 class="text-2xl font-bold text-white flex items-center gap-2">
                        <span>Armario de</span> 
                        <span id="current-user-name" class="text-blue-400 transition-colors duration-300">Iker</span>
                    </h2>
                    <p class="text-sm text-gray-400 mt-1">Organiza tu ropa por temporadas y tipos. Filtra y añade nuevas prendas fácilmente.</p>
                </div>
                <button onclick="openAddClothModal()" class="action-btn px-5 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold flex items-center justify-center gap-2 shadow-lg shadow-blue-600/25 transition-all">
                    <i class="fa-solid fa-plus text-lg"></i>
                    <span>Añadir Prenda</span>
                </button>
            </div>

            <!-- FILTERS BAR -->
            <div class="glass-panel p-4 rounded-2xl flex flex-wrap items-center justify-between gap-4">
                
                <!-- Filter Temporada -->
                <div class="flex items-center space-x-2 overflow-x-auto pb-1 sm:pb-0">
                    <span class="text-xs uppercase font-bold text-gray-500 mr-2 tracking-wider">Temporada:</span>
                    <button onclick="setFilterSeason('todos')" id="filter-season-todos" class="season-filter-btn text-xs px-3 py-1.5 rounded-lg bg-white/10 text-white font-medium border border-white/10">Todas</button>
                    <button onclick="setFilterSeason('verano')" id="filter-season-verano" class="season-filter-btn text-xs px-3 py-1.5 rounded-lg bg-black/40 text-gray-400 hover:text-white border border-white/5">Verano</button>
                    <button onclick="setFilterSeason('invierno')" id="filter-season-invierno" class="season-filter-btn text-xs px-3 py-1.5 rounded-lg bg-black/40 text-gray-400 hover:text-white border border-white/5">Invierno</button>
                    <button onclick="setFilterSeason('deportiva')" id="filter-season-deportiva" class="season-filter-btn text-xs px-3 py-1.5 rounded-lg bg-black/40 text-gray-400 hover:text-white border border-white/5">Deportiva</button>
                </div>

                <!-- Filter Subtipo -->
                <div class="flex items-center space-x-2">
                    <span class="text-xs uppercase font-bold text-gray-500 mr-1 tracking-wider">Categoría:</span>
                    <select id="filter-category-select" onchange="applyFilters()" class="bg-black/60 border border-darkborder text-xs rounded-lg px-3 py-1.5 text-gray-300 focus:outline-none focus:border-blue-500">
                        <option value="todas">Todas las prendas</option>
                        <optgroup label="Superiores">
                            <option value="jerseys">Jerseys</option>
                            <option value="camisas">Camisas</option>
                            <option value="camisetas">Camisetas</option>
                            <option value="cazadoras">Cazadoras</option>
                        </optgroup>
                        <optgroup label="Inferiores">
                            <option value="jeans">Jeans</option>
                            <option value="pantalones">Pantalones</option>
                            <option value="bermudas">Bermudas</option>
                            <option value="faldas" id="option-falda-filter" class="hidden">Faldas</option>
                        </optgroup>
                        <optgroup label="Calzado">
                            <option value="zapatillas">Zapatillas</option>
                            <option value="zapatos">Zapatos</option>
                            <option value="botas">Botas</option>
                            <option value="sandalias">Sandalias</option>
                        </optgroup>
                        <optgroup label="Accesorios">
                            <option value="relojes">Relojes</option>
                            <option value="gafas">Gafas de sol</option>
                            <option value="gorras">Gorras / Sombreros</option>
                            <option value="bufandas">Bufandas / Cinturones</option>
                            <option value="bolsos">Bolsos / Mochilas</option>
                        </optgroup>
                    </select>
                </div>

            </div>

            <!-- CLOTHES GRID -->
            <div id="clothes-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-6">
                <!-- Dynamically Populated -->
            </div>

            <!-- Empty Clothes State -->
            <div id="clothes-empty-state" class="hidden text-center py-16 bg-darkcard/50 rounded-2xl border border-dashed border-darkborder">
                <i class="fa-solid fa-shirt text-4xl text-gray-600 mb-3"></i>
                <h3 class="text-lg font-medium text-gray-300">No se encontraron prendas</h3>
                <p class="text-xs text-gray-500 mt-1">Intenta cambiar los filtros o añade ropa a tu armario.</p>
            </div>

        </section>

        <!-- ================= TAB 2: GENERADOR DE OUTFITS ================= -->
        <section id="tab-outfits" class="hidden space-y-6">
            
            <div class="bg-gradient-to-r from-darkcard via-black to-darkcard p-6 sm:p-8 rounded-2xl border border-darkborder shadow-xl text-center max-w-3xl mx-auto">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-indigo-600 to-purple-600 flex items-center justify-center text-white text-2xl mx-auto mb-4 shadow-lg shadow-purple-500/30">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                </div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Generador de Outfits Inteligente</h2>
                <p class="text-sm text-gray-400 mt-2 max-w-lg mx-auto">Selecciona la ocasión o temporada y deja que el algoritmo cree la mejor combinación de partes superiores e inferiores.</p>
                
                <!-- Season selector for generator -->
                <div class="flex justify-center items-center gap-3 mt-6">
                    <select id="outfit-season-select" class="bg-black/80 border border-white/20 text-sm font-medium rounded-xl px-4 py-2 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="verano">☀️ Outfits de Verano</option>
                        <option value="invierno">❄️ Outfits de Invierno</option>
                        <option value="deportiva">⚽ Ropa Deportiva</option>
                    </select>
                    
                    <button onclick="generateOutfitCombination()" class="px-6 py-2.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-semibold rounded-xl shadow-lg shadow-blue-500/25 flex items-center gap-2 transition-all">
                        <i class="fa-solid fa-arrows-rotate"></i>
                        <span>Proponer Outfits</span>
                    </button>
                </div>
            </div>

            <!-- OUTFIT RESULT CARDS -->
            <div id="outfits-container" class="space-y-6">
                <!-- Dynamically Populated Outfits -->
            </div>

        </section>

        <!-- ================= TAB 3: WISHLIST ================= -->
        <section id="tab-wishlist" class="hidden space-y-6">
            
            <!-- Header section & Add wishlist button -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-darkcard p-6 rounded-2xl border border-darkborder shadow-xl">
                <div>
                    <h2 class="text-2xl font-bold text-white flex items-center gap-2">
                        <span>Lista de Deseos de</span> 
                        <span id="wishlist-user-name" class="text-blue-400">Iker</span>
                    </h2>
                    <p class="text-sm text-gray-400 mt-1">Guarda las prendas que quieres comprar en tus tiendas favoritas.</p>
                </div>
                <button onclick="openWishlistModal()" class="action-btn px-5 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold flex items-center justify-center gap-2 shadow-lg shadow-blue-600/25 transition-all">
                    <i class="fa-solid fa-plus text-lg"></i>
                    <span>Añadir a Wishlist</span>
                </button>
            </div>

            <!-- WISHLIST GRID -->
            <div id="wishlist-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                <!-- Dynamically Populated -->
            </div>

            <!-- Empty Wishlist State -->
            <div id="wishlist-empty-state" class="hidden text-center py-16 bg-darkcard/50 rounded-2xl border border-dashed border-darkborder">
                <i class="fa-solid fa-heart-crack text-4xl text-gray-600 mb-3"></i>
                <h3 class="text-lg font-medium text-gray-300">Tu Wishlist está vacía</h3>
                <p class="text-xs text-gray-500 mt-1">Agrega prendas que te gustaría tener en el futuro.</p>
            </div>

        </section>

    </main>

    <!-- FOOTER -->
    <footer class="border-t border-darkborder py-6 bg-black/40 text-center text-xs text-gray-500">
        <p>Smart Wardrobe &copy; 2026 - Moda e Inteligencia de Armario para Iker & Sara</p>
    </footer>

    <!-- ================= MODALS ================= -->

    <!-- MODAL: AÑADIR / EDITAR PRENDA -->
    <div id="modal-cloth" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm hidden p-4 overflow-y-auto">
        <div class="glass-panel bg-darkcard border border-darkborder w-full max-w-lg rounded-2xl shadow-2xl p-6 relative max-h-[90vh] overflow-y-auto">
            
            <button onclick="closeClothModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white text-xl">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <h3 id="modal-cloth-title" class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-shirt text-blue-400"></i> Añadir Prenda
            </h3>

            <form id="form-cloth" onsubmit="saveCloth(event)" class="space-y-4">
                <input type="hidden" id="cloth-id">

                <!-- Upload Image Area -->
                <div>
                    <label class="block text-xs font-semibold text-gray-300 uppercase mb-2">Foto de la prenda</label>
                    <div class="flex items-center justify-center w-full">
                        <label for="cloth-img-input" class="flex flex-col items-center justify-center w-full h-40 border-2 border-dashed border-gray-600 rounded-xl cursor-pointer bg-black/40 hover:bg-black/60 transition-all relative overflow-hidden group">
                            <div id="cloth-img-placeholder" class="flex flex-col items-center justify-center pt-5 pb-6">
                                <i class="fa-solid fa-cloud-arrow-up text-3xl text-gray-400 group-hover:scale-110 transition-transform mb-2"></i>
                                <p class="text-xs text-gray-400"><span class="font-semibold">Subir foto</span> o arrastrar archivo</p>
                                <p class="text-[10px] text-gray-500 mt-1">PNG, JPG o WEBP</p>
                            </div>
                            <img id="cloth-img-preview" class="hidden absolute inset-0 w-full h-full object-cover">
                            <input id="cloth-img-input" type="file" accept="image/*" class="hidden" onchange="handleClothImageUpload(event)" />
                        </label>
                    </div>
                </div>

                <!-- Simulación IA Auto-detect notice -->
                <div id="ai-detection-badge" class="hidden p-3 bg-blue-950/40 border border-blue-500/30 rounded-xl flex items-center gap-3 text-xs text-blue-300">
                    <i class="fa-solid fa-wand-magic-sparkles text-blue-400 animate-pulse text-base"></i>
                    <div>
                        <span class="font-bold">Análisis Inteligente:</span>
                        <span id="ai-detection-text">Detección completada</span>
                    </div>
                </div>

                <!-- Nombre / Descripción -->
                <div>
                    <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Nombre o Descripción</label>
                    <input type="text" id="cloth-name" required placeholder="Ej: Camiseta Oversize Negra" class="w-full bg-black/60 border border-darkborder rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500">
                </div>

                <!-- Temporada & Tipo (Sección) -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Temporada</label>
                        <select id="cloth-season" required onchange="updateClothSubtypes()" class="w-full bg-black/60 border border-darkborder rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500">
                            <option value="verano">Verano</option>
                            <option value="invierno">Invierno</option>
                            <option value="deportiva">Deportiva</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Tipo de Parte</label>
                        <select id="cloth-type" required onchange="updateClothSubtypes()" class="w-full bg-black/60 border border-darkborder rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500">
                            <option value="superior">Parte Superior</option>
                            <option value="inferior">Parte Inferior</option>
                            <option value="calzado">Calzado</option>
                            <option value="accesorio">Accesorio</option>
                        </select>
                    </div>
                </div>

                <!-- Subtipo & Color -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Categoría Especifica</label>
                        <select id="cloth-subtype" required class="w-full bg-black/60 border border-darkborder rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500">
                            <!-- Populated dynamically -->
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Color Predominante</label>
                        <input type="text" id="cloth-color" required placeholder="Ej: Negro, Azul, Blanco..." class="w-full bg-black/60 border border-darkborder rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500">
                    </div>
                </div>

                <!-- Actions -->
                <div class="flex justify-end space-x-3 pt-4 border-t border-darkborder">
                    <button type="button" onclick="closeClothModal()" class="px-4 py-2 rounded-xl text-sm font-medium text-gray-400 hover:text-white bg-black/40 border border-white/10">Cancelar</button>
                    <button type="submit" class="action-btn px-5 py-2 rounded-xl text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-lg shadow-blue-600/30">Guardar Prenda</button>
                </div>

            </form>
        </div>
    </div>


    <!-- MODAL: AÑADIR / EDITAR WISHLIST ITEM -->
    <div id="modal-wishlist" class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm hidden p-4 overflow-y-auto">
        <div class="glass-panel bg-darkcard border border-darkborder w-full max-w-lg rounded-2xl shadow-2xl p-6 relative max-h-[90vh] overflow-y-auto">
            
            <button onclick="closeWishlistModal()" class="absolute top-4 right-4 text-gray-400 hover:text-white text-xl">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <h3 id="modal-wishlist-title" class="text-xl font-bold text-white mb-4 flex items-center gap-2">
                <i class="fa-solid fa-heart text-pink-500"></i> Añadir a Wishlist
            </h3>

            <form id="form-wishlist" onsubmit="saveWishlistItem(event)" class="space-y-4">
                <input type="hidden" id="wishlist-id">

                <!-- Upload Image or URL -->
                <div>
                    <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Imagen del Producto</label>
                    <div class="flex flex-col gap-2">
                        <input type="file" id="wishlist-img-file" accept="image/*" class="text-xs text-gray-400 bg-black/40 border border-darkborder rounded-lg p-2" onchange="handleWishlistImageUpload(event)">
                        <input type="url" id="wishlist-img-url" placeholder="O pega URL de la imagen..." class="w-full bg-black/60 border border-darkborder rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-blue-500">
                    </div>
                </div>

                <!-- Nombre -->
                <div>
                    <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Nombre de la Prenda</label>
                    <input type="text" id="wishlist-name" required placeholder="Ej: Chaqueta de Cuero Vintage" class="w-full bg-black/60 border border-darkborder rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500">
                </div>

                <!-- Tienda & Precio -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Tienda</label>
                        <input type="text" id="wishlist-store" required placeholder="Ej: Zara, Nike, Mango" class="w-full bg-black/60 border border-darkborder rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Precio (€)</label>
                        <input type="number" step="0.01" id="wishlist-price" required placeholder="49.99" class="w-full bg-black/60 border border-darkborder rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500">
                    </div>
                </div>

                <!-- Enlace de compra -->
                <div>
                    <label class="block text-xs font-semibold text-gray-300 uppercase mb-1">Enlace / Web de Compra</label>
                    <input type="url" id="wishlist-url" placeholder="https://www.tienda.com/producto" class="w-full bg-black/60 border border-darkborder rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-blue-500">
                </div>

                <!-- Actions -->
                <div class="flex justify-end space-x-3 pt-4 border-t border-darkborder">
                    <button type="button" onclick="closeWishlistModal()" class="px-4 py-2 rounded-xl text-sm font-medium text-gray-400 hover:text-white bg-black/40 border border-white/10">Cancelar</button>
                    <button type="submit" class="action-btn px-5 py-2 rounded-xl text-sm font-semibold text-white bg-blue-600 hover:bg-blue-500 shadow-lg shadow-blue-600/30">Guardar Wishlist</button>
                </div>

            </form>
        </div>
    </div>

    <!-- MAIN JAVASCRIPT APP LOGIC -->
    <script>
        // --- INITIAL DATA & PRELOAD SAMPLES ---
        const initialData = {
            iker: {
                clothes: [
