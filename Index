        function updateClothSubtypes() {
            const season = document.getElementById('cloth-season').value;
            const type = document.getElementById('cloth-type').value;
            const subtypeSelect = document.getElementById('cloth-subtype');
            subtypeSelect.innerHTML = '';

            let options = [];
            if (type === 'superior') {
                options = ['jerseys', 'camisas', 'camisetas', 'cazadoras'];
            } else if (type === 'inferior') {
                options = ['jeans', 'pantalones', 'bermudas'];
                if (currentUser === 'sara') {
                    options.push('faldas');
                }
            } else if (type === 'calzado') {
                options = ['zapatillas', 'zapatos', 'botas', 'sandalias'];
            } else if (type === 'accesorio') {
                options = ['relojes', 'gafas', 'gorras', 'bufandas', 'bolsos'];
            }

            options.forEach(opt => {
                const el = document.createElement('option');
                el.value = opt;
                el.textContent = opt.charAt(0).toUpperCase() + opt.slice(1);
                subtypeSelect.appendChild(el);
            });
        }

        function simulateAiImageAnalysis(fileName) {
            const nameLower = fileName.toLowerCase();
            const badge = document.getElementById('ai-detection-badge');
            const text = document.getElementById('ai-detection-text');
            badge.classList.remove('hidden');

            let detectedColor = "Negro";
            let detectedSubtype = "camisetas";
            let detectedType = "superior";
            let detectedSeason = "verano";

            // Simulated color detection heuristics
            if (nameLower.includes('blanc') || nameLower.includes('white')) detectedColor = "Blanco";
            else if (nameLower.includes('azul') || nameLower.includes('blue')) detectedColor = "Azul";
            else if (nameLower.includes('rojo') || nameLower.includes('red')) detectedColor = "Rojo";
            else if (nameLower.includes('verde') || nameLower.includes('green')) detectedColor = "Verde";
            else if (nameLower.includes('gris') || nameLower.includes('grey')) detectedColor = "Gris";
            else if (nameLower.includes('beige')) detectedColor = "Beige";

            // Simulated subtype detection
            if (nameLower.includes('zapat') || nameLower.includes('bota') || nameLower.includes('sandalia') || nameLower.includes('sneaker')) {
                detectedType = "calzado";
                if (nameLower.includes('bota')) detectedSubtype = "botas";
                else if (nameLower.includes('sandalia')) detectedSubtype = "sandalias";
                else if (nameLower.includes('zapato')) detectedSubtype = "zapatos";
                else detectedSubtype = "zapatillas";
            } else if (nameLower.includes('reloj') || nameLower.includes('gafa') || nameLower.includes('gorra') || nameLower.includes('bolso') || nameLower.includes('cinturon')) {
                detectedType = "accesorio";
                if (nameLower.includes('reloj')) detectedSubtype = "relojes";
                else if (nameLower.includes('gafa')) detectedSubtype = "gafas";
                else if (nameLower.includes('gorra')) detectedSubtype = "gorras";
                else if (nameLower.includes('bolso')) detectedSubtype = "bolsos";
                else detectedSubtype = "bufandas";
            } else if (nameLower.includes('pantalo') || nameLower.includes('jean') || nameLower.includes('bermuda') || nameLower.includes('falda')) {
                detectedType = "inferior";
                if (nameLower.includes('jean')) detectedSubtype = "jeans";
                else if (nameLower.includes('bermuda')) detectedSubtype = "bermudas";
                else if (nameLower.includes('falda')) detectedSubtype = "faldas";
                else detectedSubtype = "pantalones";
            } else if (nameLower.includes('jersey') || nameLower.includes('sueter')) {
                detectedSubtype = "jerseys";
                detectedSeason = "invierno";
            } else if (nameLower.includes('camisa')) {
                detectedSubtype = "camisas";
            } else if (nameLower.includes('cazadora') || nameLower.includes('chaqueta')) {
                detectedSubtype = "cazadoras";
                detectedSeason = "invierno";
            }

            // Fill form fields automatically
            document.getElementById('cloth-color').value = detectedColor;
            document.getElementById('cloth-season').value = detectedSeason;
            document.getElementById('cloth-type').value = detectedType;
            updateClothSubtypes();
            document.getElementById('cloth-subtype').value = detectedSubtype;

            if (!document.getElementById('cloth-name').value) {
                document.getElementById('cloth-name').value = `${detectedSubtype.charAt(0).toUpperCase() + detectedSubtype.slice(1)} ${detectedColor}`;
            }

            text.textContent = `Prenda detectada: ${detectedSubtype.toUpperCase()} - Color: ${detectedColor}`;
        }

        function saveCloth(e) {
            e.preventDefault();
            const data = getStoredData();
            const id = document.getElementById('cloth-id').value;
            const name = document.getElementById('cloth-name').value;
            const season = document.getElementById('cloth-season').value;
            const type = document.getElementById('cloth-type').value;
            const subtype = document.getElementById('cloth-subtype').value;
            const color = document.getElementById('cloth-color').value;

            let imgSrc = currentUploadedImageBase64;

            if (id) {
                // Edit existing
                const index = data[currentUser].clothes.findIndex(c => c.id === id);
                if (index !== -1) {
                    if (!imgSrc) imgSrc = data[currentUser].clothes[index].img;
                    data[currentUser].clothes[index] = { id, name, season, type, subtype, color, img: imgSrc };
                }
            } else {
                // Create new
                if (!imgSrc) {
                    imgSrc = 'https://images.unsplash.com/photo-1523381210434-271e8be1f52b?auto=format&fit=crop&w=600&q=80';
                }
                const newCloth = {
                    id: 'c_' + Date.now(),
                    name, season, type, subtype, color, img: imgSrc
                };
                data[currentUser].clothes.unshift(newCloth);
            }

            saveStoredData(data);
            closeClothModal();
            renderClothes();
        }

        function editCloth(id) {
            const data = getStoredData();
            const cloth = data[currentUser].clothes.find(c => c.id === id);
            if (!cloth) return;

            document.getElementById('modal-cloth-title').textContent = "Editar Prenda";
            document.getElementById('cloth-id').value = cloth.id;
            document.getElementById('cloth-name').value = cloth.name;
            document.getElementById('cloth-season').value = cloth.season;
            document.getElementById('cloth-type').value = cloth.type;
            updateClothSubtypes();
            document.getElementById('cloth-subtype').value = cloth.subtype;
            document.getElementById('cloth-color').value = cloth.color;

            const preview = document.getElementById('cloth-img-preview');
            preview.src = cloth.img;
            preview.classList.remove('hidden');
            document.getElementById('cloth-img-placeholder').classList.add('hidden');
            currentUploadedImageBase64 = cloth.img;

            document.getElementById('modal-cloth').classList.remove('hidden');
        }

        function deleteCloth(id) {
            const data = getStoredData();
            data[currentUser].clothes = (data[currentUser].clothes || []).filter(c => String(c.id) !== String(id));
            saveStoredData(data);
            renderClothes();
            if (currentTab === 'outfits') {
                generateOutfitCombination();
            }
        }

        // --- OUTFIT GENERATOR LOGIC ---
        function generateOutfitCombination() {
