            const footwear = userClothes.filter(c => c.season === season && c.type === 'calzado');

            if (uppers.length === 0 || lowers.length === 0) {
                container.innerHTML = `
                    <div class="glass-panel p-8 text-center rounded-2xl border border-dashed border-darkborder max-w-xl mx-auto">
                        <i class="fa-solid fa-triangle-exclamation text-amber-400 text-3xl mb-3"></i>
                        <h4 class="text-base font-bold text-white">Prendas Insuficientes</h4>
                        <p class="text-xs text-gray-400 mt-1">Necesitas tener al menos una parte superior y una parte inferior registradas para la temporada "${season.toUpperCase()}" en el armario de ${currentUser.toUpperCase()}.</p>
                    </div>
                `;
                return;
            }

            // Generate combinations randomly
            const combinationsCount = Math.min(2, Math.max(1, Math.min(uppers.length, lowers.length)));
            const usedUpperIndexes = new Set();
            const usedLowerIndexes = new Set();
            const usedFootwearIndexes = new Set();

            for (let i = 0; i < combinationsCount; i++) {
                let uIdx, lIdx, fIdx = null;
                
                do {
                    uIdx = Math.floor(Math.random() * uppers.length);
                } while (usedUpperIndexes.has(uIdx) && usedUpperIndexes.size < uppers.length);
                usedUpperIndexes.add(uIdx);

                do {
                    lIdx = Math.floor(Math.random() * lowers.length);
                } while (usedLowerIndexes.has(lIdx) && usedLowerIndexes.size < lowers.length);
                usedLowerIndexes.add(lIdx);

                if (footwear.length > 0) {
                    do {
                        fIdx = Math.floor(Math.random() * footwear.length);
                    } while (usedFootwearIndexes.has(fIdx) && usedFootwearIndexes.size < footwear.length);
                    usedFootwearIndexes.add(fIdx);
                }

                const topItem = uppers[uIdx];
                const bottomItem = lowers[lIdx];
                const footwearItem = fIdx !== null ? footwear[fIdx] : null;

                // Create Outfit Suggestion Card
                const outfitCard = document.createElement('div');
                outfitCard.className = "glass-panel p-6 rounded-2xl max-w-4xl mx-auto border border-white/10 shadow-2xl relative overflow-hidden";
                
                outfitCard.innerHTML = `
                    <div class="flex items-center justify-between pb-4 mb-6 border-b border-white/10">
                        <div class="flex items-center space-x-3">
                            <span class="w-8 h-8 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center font-bold text-sm">#${i+1}</span>
                            <div>
                                <h3 class="text-lg font-bold text-white">Combinación ${season.toUpperCase()}</h3>
                                <p class="text-xs text-gray-400">Armonía de Colores: ${topItem.color} + ${bottomItem.color} ${footwearItem ? '+ ' + footwearItem.color : ''}</p>
                            </div>
                        </div>
                        <span class="text-xs px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center gap-1 font-medium">
                            <i class="fa-solid fa-check"></i> Match Sugerido
                        </span>
                    </div>

                    <div class="grid grid-cols-1 ${footwearItem ? 'md:grid-cols-3' : 'md:grid-cols-2'} gap-4 items-center">
                        <!-- Top item card -->
                        <div class="bg-black/40 rounded-xl p-4 border border-white/5 flex items-center space-x-3">
                            <img src="${topItem.img}" alt="${topItem.name}" class="w-20 h-20 object-cover rounded-lg border border-darkborder flex-shrink-0">
                            <div>
                                <span class="text-[10px] text-blue-400 uppercase font-bold tracking-wider">Parte Superior</span>
                                <h4 class="text-xs font-bold text-white mt-1 line-clamp-1">${topItem.name}</h4>
                                <div class="text-[11px] text-gray-400 mt-1">Categoría: ${topItem.subtype}</div>
                                <div class="text-[11px] text-gray-400">Color: <span class="text-gray-200 font-medium">${topItem.color}</span></div>
                            </div>
                        </div>

                        <!-- Bottom item card -->
                        <div class="bg-black/40 rounded-xl p-4 border border-white/5 flex items-center space-x-3">
                            <img src="${bottomItem.img}" alt="${bottomItem.name}" class="w-20 h-20 object-cover rounded-lg border border-darkborder flex-shrink-0">
                            <div>
                                <span class="text-[10px] text-pink-400 uppercase font-bold tracking-wider">Parte Inferior</span>
                                <h4 class="text-xs font-bold text-white mt-1 line-clamp-1">${bottomItem.name}</h4>
                                <div class="text-[11px] text-gray-400 mt-1">Categoría: ${bottomItem.subtype}</div>
                                <div class="text-[11px] text-gray-400">Color: <span class="text-gray-200 font-medium">${bottomItem.color}</span></div>
                            </div>
                        </div>

                        <!-- Footwear card (if available) -->
                        ${footwearItem ? `
                            <div class="bg-black/40 rounded-xl p-4 border border-white/5 flex items-center space-x-3">
                                <img src="${footwearItem.img}" alt="${footwearItem.name}" class="w-20 h-20 object-cover rounded-lg border border-darkborder flex-shrink-0">
                                <div>
                                    <span class="text-[10px] text-purple-400 uppercase font-bold tracking-wider">Calzado</span>
                                    <h4 class="text-xs font-bold text-white mt-1 line-clamp-1">${footwearItem.name}</h4>
                                    <div class="text-[11px] text-gray-400 mt-1">Categoría: ${footwearItem.subtype}</div>
                                    <div class="text-[11px] text-gray-400">Color: <span class="text-gray-200 font-medium">${footwearItem.color}</span></div>
                                </div>
                            </div>
                        ` : ''}
                    </div>
                `;
                container.appendChild(outfitCard);
            }
        }

        // --- WISHLIST LOGIC & RENDER ---
        function renderWishlist() {
            const data = getStoredData();
            const items = data[currentUser].wishlist || [];
            const grid = document.getElementById('wishlist-grid');
            const emptyState = document.getElementById('wishlist-empty-state');

            grid.innerHTML = '';

            if (items.length === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');

                items.forEach(item => {
                    const card = document.createElement('div');
                    card.className = `glass-card rounded-2xl overflow-hidden flex flex-col group relative ${item.purchased ? 'opacity-60' : ''}`;
                    
                    card.innerHTML = `
                        <div class="relative h-52 w-full bg-black/40 overflow-hidden">
                            <img src="${item.img}" alt="${item.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" onerror="this.src='https://placehold.co/400x400/1e1e24/ffffff?text=Wishlist+Item'">
                            
                            <!-- Purchased Badge -->
                            ${item.purchased ? `
                                <div class="absolute inset-0 bg-black/60 backdrop-blur-xs flex items-center justify-center">
                                    <span class="bg-emerald-600 text-white font-bold text-xs px-3 py-1 rounded-full shadow-lg">COMPRADO</span>
                                </div>
                            ` : ''}

                            <div class="absolute top-2 right-2 flex space-x-1 opacity-0 group-hover:opacity-100 transition-opacity bg-black/60 p-1 rounded-xl backdrop-blur-md z-20">
                                <button type="button" data-edit-wish-id="${item.id}" class="btn-edit-wishlist p-1.5 text-xs text-gray-300 hover:text-white hover:bg-white/10 rounded-lg transition-colors" title="Editar">
                                    <i class="fa-solid fa-pen pointer-events-none"></i>
                                </button>
                                <button type="button" data-delete-wish-id="${item.id}" class="btn-delete-wishlist p-1.5 text-xs text-red-400 hover:text-red-300 hover:bg-red-500/20 rounded-lg transition-colors" title="Eliminar">
                                    <i class="fa-solid fa-trash pointer-events-none"></i>
                                </button>
                            </div>
                        </div>

                        <div class="p-4 flex flex-col flex-grow justify-between">
                            <div>
                                <span class="text-[10px] uppercase font-bold text-gray-400 tracking-wider">${item.store}</span>
                                <h4 class="text-sm font-bold text-white mt-0.5 line-clamp-1">${item.name}</h4>
                                <p class="text-base font-extrabold text-emerald-400 mt-2">${item.price.toFixed(2)} €</p>
                            </div>

                            <div class="mt-4 pt-3 border-t border-white/5 flex items-center justify-between gap-2">
                                <button type="button" onclick="togglePurchased('${item.id}')" class="text-xs px-3 py-1.5 rounded-lg border border-white/10 ${item.purchased ? 'bg-emerald-600/20 text-emerald-300' : 'bg-white/5 text-gray-300 hover:text-white'} transition-colors">
                                    <i class="fa-solid ${item.purchased ? 'fa-check-circle' : 'fa-circle'} mr-1"></i>
                                    ${item.purchased ? 'Comprado' : 'Pendiente'}
                                </button>

                                ${item.url ? `
                                    <a href="${item.url}" target="_blank" class="text-xs px-3 py-1.5 rounded-lg bg-blue-600/20 hover:bg-blue-600/40 text-blue-300 border border-blue-500/30 font-medium flex items-center gap-1 transition-colors">
                                        <span>Ir a Tienda</span>
                                        <i class="fa-solid fa-up-right-from-square text-[10px]"></i>
                                    </a>
                                ` : ''}
                            </div>
                        </div>
                    `;
                    grid.appendChild(card);
                });

                // Attach event listeners for wishlist
                grid.querySelectorAll('.btn-edit-wishlist').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        editWishlistItem(btn.getAttribute('data-edit-wish-id'));
                    });
                });

                grid.querySelectorAll('.btn-delete-wishlist').forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        deleteWishlistItem(btn.getAttribute('data-delete-wish-id'));
                    });
                });
            }
        }

        function openWishlistModal() {
            document.getElementById('modal-wishlist-title').innerHTML = `<i class="fa-solid fa-heart text-${currentUser === 'iker' ? 'blue' : 'pink'}-500"></i> Añadir a Wishlist`;
            document.getElementById('form-wishlist').reset();
            document.getElementById('wishlist-id').value = '';
            currentWishlistImageBase64 = null;
            document.getElementById('modal-wishlist').classList.remove('hidden');
        }

        function closeWishlistModal() {
            document.getElementById('modal-wishlist').classList.add('hidden');
        }

        function handleWishlistImageUpload(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(event) {
                currentWishlistImageBase64 = event.target.result;
            };
            reader.readAsDataURL(file);
        }

        function saveWishlistItem(e) {
            e.preventDefault();
            const data = getStoredData();
            const id = document.getElementById('wishlist-id').value;
            const name = document.getElementById('wishlist-name').value;
            const store = document.getElementById('wishlist-store').value;
            const price = parseFloat(document.getElementById('wishlist-price').value) || 0;
            const url = document.getElementById('wishlist-url').value;
            const urlImg = document.getElementById('wishlist-img-url').value;

            let imgSrc = currentWishlistImageBase64 || urlImg;

            if (id) {
                const index = data[currentUser].wishlist.findIndex(w => w.id === id);
                if (index !== -1) {
                    if (!imgSrc) imgSrc = data[currentUser].wishlist[index].img;
                    data[currentUser].wishlist[index] = {
                        ...data[currentUser].wishlist[index],
                        name, store, price, url, img: imgSrc
                    };
                }
            } else {
                if (!imgSrc) {
                    imgSrc = 'https://images.unsplash.com/photo-1489987707025-afc232f7ea0f?auto=format&fit=crop&w=600&q=80';
                }
                const newItem = {
                    id: 'w_' + Date.now(),
                    name, store, price, url, img: imgSrc, purchased: false
                };
                data[currentUser].wishlist.unshift(newItem);
            }

            saveStoredData(data);
            closeWishlistModal();
            renderWishlist();
        }

        function editWishlistItem(id) {
            const data = getStoredData();
            const item = data[currentUser].wishlist.find(w => w.id === id);
            if (!item) return;

            document.getElementById('modal-wishlist-title').textContent = "Editar Wishlist";
            document.getElementById('wishlist-id').value = item.id;
            document.getElementById('wishlist-name').value = item.name;
            document.getElementById('wishlist-store').value = item.store;
            document.getElementById('wishlist-price').value = item.price;
            document.getElementById('wishlist-url').value = item.url || '';
            document.getElementById('wishlist-img-url').value = item.img.startsWith('http') ? item.img : '';

            document.getElementById('modal-wishlist').classList.remove('hidden');
        }

        function togglePurchased(id) {
            const data = getStoredData();
            const item = data[currentUser].wishlist.find(w => w.id === id);
            if (item) {
                item.purchased = !item.purchased;
                saveStoredData(data);
                renderWishlist();
            }
        }

        function deleteWishlistItem(id) {
            const data = getStoredData();
            data[currentUser].wishlist = (data[currentUser].wishlist || []).filter(w => String(w.id) !== String(id));
            saveStoredData(data);
            renderWishlist();
        }
    </script>
</body>
</html>
